# Preset: the app on https://<mac>.local:8443, over the Wi-Fi, through a local TLS proxy (caddy)
# with a mkcert certificate. For a real iPhone that trusts the mkcert root CA. See
# docs/dev/mobile-testing.md ("Real iPhone: mkcert").
#
#   cp .env.lan.example .env            # then replace every `<mac>` and `replace-me`
#
# `<mac>` is the Mac's Bonjour name: `scutil --get LocalHostName` (e.g. `my-mac` -> my-mac.local).
# `.env` is git-ignored; never commit real values. The full variable reference is .env.example.

DATABASE_URL=postgres://iron_oxide:iron_oxide@localhost:5433/iron_oxide

# The URL the phone opens, served by caddy on port 8443 (dx or the release server stays on
# 127.0.0.1:8080 behind it). Server functions reject requests from any other origin.
APP_BASE_URL=https://<mac>.local:8443

# Passkeys: the RP ID must be the origin's host. Whether Safari accepts a `.local` RP ID is
# unverified; if passkeys fail here, use the Tailscale preset.
WEBAUTHN_RP_ID=<mac>.local
WEBAUTHN_ORIGIN=https://<mac>.local:8443

# Google CANNOT work on this host: Google refuses redirect URIs whose top-level domain is not on the
# Public Suffix List, and `.local` is not. The values are still required for the server to start;
# reuse the local client and expect "redirect_uri_mismatch" if you try Google here.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URL=https://<mac>.local:8443/auth/google/callback

# openssl rand 64 | openssl base64 -A
SESSION_KEY=replace-me
