# Keep the build context small and free of secrets. The build needs Cargo.toml, Cargo.lock,
# rust-toolchain.toml, .cargo/ and crates/ (plus assets and migrations once they exist).

# Build output
target/
dist/

# Environment files and keys: never sent to a builder, even a remote one.
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# VCS, CI and docs
.git/
.github/
docs/
*.md

# Local tooling, editors and OS files
.remember/
.idea/
.vscode/
*.iml
*.swp
*.swo
*~
.DS_Store
node_modules/

# Container and host config
Dockerfile
.dockerignore
fly.toml
docker-compose*.yml
compose*.yml
