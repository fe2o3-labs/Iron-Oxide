# Preset: the app on https://<machine>.<tailnet>.ts.net, published to your tailnet by
# `tailscale serve --bg --https=443 localhost:8080`. For a real iPhone (or any device) running
# Tailscale. See docs/dev/mobile-testing.md ("Real iPhone: Tailscale").
#
#   cp .env.tailscale.example .env      # then replace every `<machine>.<tailnet>` and `replace-me`
#
# The exact host is the "DNSName" printed by `tailscale status --json` (without the final dot).
# `.env` is git-ignored; never commit real values. The full variable reference is .env.example.

DATABASE_URL=postgres://iron_oxide:iron_oxide@localhost:5433/iron_oxide

# No port: `tailscale serve` listens on 443 and proxies to 127.0.0.1:8080.
APP_BASE_URL=https://<machine>.<tailnet>.ts.net

# Passkeys: the RP ID is the full machine host. Passkeys made here only work on this host, never on
# localhost or iron-oxyde.com.
WEBAUTHN_RP_ID=<machine>.<tailnet>.ts.net
WEBAUTHN_ORIGIN=https://<machine>.<tailnet>.ts.net

# Google: a separate "Iron Oxide (tailscale)" Web client whose authorized redirect URI is exactly
# https://<machine>.<tailnet>.ts.net/auth/google/callback
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URL=https://<machine>.<tailnet>.ts.net/auth/google/callback

# openssl rand 64 | openssl base64 -A
SESSION_KEY=replace-me
