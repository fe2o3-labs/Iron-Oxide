# Preset: the app on http://localhost:8080. For the Mac's browsers, the iOS Simulator, and Android
# (emulator or USB phone) through `adb reverse tcp:8080 tcp:8080`. See docs/dev/mobile-testing.md.
#
#   cp .env.localhost.example .env      # then replace every `replace-me`
#
# `.env` is git-ignored; never commit real values. The full variable reference is .env.example.

DATABASE_URL=postgres://iron_oxide:iron_oxide@localhost:5433/iron_oxide

# Open the app on exactly this origin (localhost, not 127.0.0.1): server functions reject any other
# Origin, and passkeys are bound to the RP ID below.
APP_BASE_URL=http://localhost:8080

# Passkeys: localhost is a secure context, so plain http works here. Passkeys made on localhost only
# work on localhost.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8080

# Google: the "Iron Oxide (local)" client from docs/auth.md, whose authorized redirect URI is
# exactly http://localhost:8080/auth/google/callback
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# openssl rand 64 | openssl base64 -A
SESSION_KEY=replace-me
