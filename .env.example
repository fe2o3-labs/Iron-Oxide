# Iron Oxide server configuration. Copy to `.env` for local development: `cp .env.example .env`.
# `.env` is git-ignored; never commit real values. In production, set real environment variables
# instead (they take precedence over `.env`).
#
# The server validates everything at startup and exits with a message naming each missing or
# invalid variable. Blank values count as unset.

# --- Required -----------------------------------------------------------------------------------

# Postgres connection URL. Locally: the docker compose database (`docker compose up -d`).
# On Neon, use the DIRECT endpoint (host without `-pooler`) with `?sslmode=require`.
DATABASE_URL=postgres://iron_oxide:iron_oxide@localhost:5433/iron_oxide

# Public URL the app is served from.
APP_BASE_URL=http://localhost:8080

# --- Optional -----------------------------------------------------------------------------------

# Bind address. Defaults: 127.0.0.1 and 8080. `dx serve` sets these itself; in a container use
# IP=0.0.0.0.
# IP=127.0.0.1
# PORT=8080

# Log filter (tracing EnvFilter syntax). Default: debug in debug builds, info in release builds.
# RUST_LOG=info,sqlx=warn

# --- Sign-in (#5) -------------------------------------------------------------------------------
# Optional until sign-in lands, but all-or-nothing: set all six or none.

# WebAuthn relying party ID: the site's domain (no scheme or port), and the exact origin.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:8080

# Sign in with Google: an OAuth "Web application" client from the Google Cloud console.
# GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=replace-me
# GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Session cookie key: at least 64 random bytes, base64-encoded. Generate one with
# `openssl rand 64 | openssl base64 -A`. Use a different key in every environment.
# SESSION_KEY=replace-me
