# Iron Oxide server configuration. Copy to `.env` for local development: `cp .env.example .env`.
# `.env` is git-ignored; never commit real values. In production, set real environment variables
# instead (they take precedence over `.env`).
#
# The server validates everything at startup and exits with a message naming each missing or
# invalid variable. Blank values count as unset.

# --- Required -----------------------------------------------------------------------------------

# Postgres connection URL. Locally: the docker compose database (`docker compose up -d`).
# On Neon, use the DIRECT endpoint (host without `-pooler`) with `?sslmode=require`.
# Percent-encode special characters in the password (/ as %2F, @ as %40, # as %23, ? as %3F).
DATABASE_URL=postgres://iron_oxide:iron_oxide@localhost:5433/iron_oxide

# Public URL the app is served from.
APP_BASE_URL=http://localhost:8080

# --- Optional -----------------------------------------------------------------------------------

# Bind address. Defaults: 127.0.0.1 and 8080. `dx serve` sets these itself; in a container use
# IP=0.0.0.0.
# IP=127.0.0.1
# PORT=8080

# Log filter (tracing EnvFilter syntax). Default: debug in debug builds, info in release builds.
# RUST_LOG=info,sqlx=warn

# Seconds in-flight requests get to finish after SIGINT/SIGTERM (1-300, default 20). Keep it below
# the platform's kill timeout (30 s in fly.toml).
# SHUTDOWN_GRACE_SECS=20

# Where the rate limits take the client IP from (docs/rate-limiting.md): `peer` (default: the TCP
# peer address) or `fly` (the `Fly-Client-IP` header, only believed from a private peer such as
# Fly's proxy). Only set `fly` behind Fly.io: fly.toml does.
# CLIENT_IP_SOURCE=peer

# --- Sign-in (#5, see docs/auth.md) ------------------------------------------------------------
# Required. The values below work for local development at http://localhost:8080, except the
# Google client and the session key, which you must create (see docs/auth.md).

# WebAuthn relying party ID: the site's domain (no scheme or port). Production: iron-oxyde.com.
WEBAUTHN_RP_ID=localhost
# The exact origin of APP_BASE_URL. Production: https://iron-oxyde.com.
WEBAUTHN_ORIGIN=http://localhost:8080

# Sign in with Google: an OAuth "Web application" client from the Google Cloud console.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
# APP_BASE_URL's origin + /auth/google/callback, registered as a redirect URI of the client.
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Session cookie signing key: at least 64 random bytes, base64-encoded. Generate one with
# `openssl rand 64 | openssl base64 -A`. Use a different key in every environment.
SESSION_KEY=replace-me
